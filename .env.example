# GitHub Pages project-site path. The deploy workflow sets this automatically from the
# repository name; set it yourself only for local preview of the Pages build.
# PAGES_BASE_PATH=/sacrifice-blunt
#
# Public site URL used for canonical links, sitemap and social cards.
# Defaults to https://bbowenstl-droid.github.io<PAGES_BASE_PATH>.
# NEXT_PUBLIC_SITE_URL=https://bbowenstl-droid.github.io/sacrifice-blunt
#
# No secrets belong in this project: everything ships to the browser as static files.
